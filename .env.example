# Product URLs loaded by the Wujie host at /app/:appId/*
VITE_APP_HUIGUANG_URL=https://huiguang.shiguanglab.com
VITE_APP_SICHEN_URL=https://sichen.example.com
VITE_APP_CHAT_URL=https://chat.example.com
VITE_APP_KNOWLEDGE_URL=https://knowledge.example.com
VITE_APP_WORKFLOW_URL=https://workflow.example.com
VITE_APP_MARKET_URL=https://market.example.com
VITE_APP_TEAM_URL=https://team.example.com

# Desktop client release artifacts linked from /sichen
VITE_SICHEN_WINDOWS_DOWNLOAD_URL=/downloads/sichen-windows-x64.exe
VITE_SICHEN_MAC_DOWNLOAD_URL=/downloads/sichen-macos-universal.dmg
VITE_SICHEN_LINUX_DOWNLOAD_URL=/downloads/sichen-linux-x86_64.AppImage

# Used by `SITE_URL=https://example.com npm run build` for canonical and sitemap URLs.
SITE_URL=https://www.example.com

# Local Vite only: proxy the same-origin /api/auth calls to the deployed gateway.
AUTH_PROXY_TARGET=https://shiguanglab.com
